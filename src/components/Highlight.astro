---
interface Props {
  class?: string;
  color?: string;
  type?: "circle" | "underline" | "box" | "strike";
}

const { class: className, color = "currentColor", type = "circle" } = Astro.props;

// Better hand-drawn inspired paths
const paths = {
  circle: "M142.293 1C106.854 16.8908 6.08202 7.17705 1.23654 43.3756C-2.10604 68.3466 29.5633 73.2652 122.688 71.7518C215.814 70.2384 316.298 70.689 275.761 38.0785C230.14 1.37835 97.0503 24.4575 52.93 65.12 142.293 72",
  underline: "M5 65 Q 143 60 281 65 Q 143 70 5 72",
  box: "M10 5 Q 143 2 276 5 Q 280 36 276 68 Q 143 71 10 68 Q 6 36 10 5",
  strike: "M5 36 Q 143 32 281 36"
};

const d = paths[type] || paths.circle;
---

<span class:list={["relative inline-block px-1", className]}>
  <span class="relative z-10"><slot /></span>
  <svg
    viewBox="0 0 286 73"
    fill="none"
    class="absolute -left-2 -right-2 -top-1 -bottom-1 w-[calc(100%+1rem)] h-[calc(100%+0.5rem)] pointer-events-none overflow-visible z-0"
    preserveAspectRatio="none"
  >
    <path
      class="draw-highlight"
      d={d}
      stroke={color}
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</span>

<style>
  .draw-highlight {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
  }
  
  :global(.is-visible) .draw-highlight {
    animation: draw 1.5s ease-in-out forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  function initHighlight() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.draw-highlight').forEach(path => {
      const parent = path.closest('.relative');
      if (parent) observer.observe(parent);
    });
  }

  initHighlight();
  document.addEventListener('astro:after-swap', initHighlight);
</script>
