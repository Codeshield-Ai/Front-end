---
import Highlight from "../Highlight.astro";

const currentYear = new Date().getFullYear();
const turnstileSiteKey = "0x4AAAAAACdwdL0cBBU2Q6IY";
---

<section
  id="contact"
  class="py-12 md:py-24 bg-[#0F0F11] relative overflow-hidden"
>
  <!-- Subtle background decorative elements -->
  <div
    class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-primary/5 blur-[100px] rounded-full translate-y-1/2 -translate-x-1/2 pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-12 relative z-10">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-24 items-center">
      <!-- Left Column: Content & Direct Info -->
      <div class="space-y-8 md:space-y-12">
        <div class="space-y-6">
          <span
            class="text-primary font-bold text-sm tracking-widest uppercase block mb-1"
            >Contact us</span
          >
          <h2
            class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl font-black uppercase leading-[1.1] text-white tracking-tight"
          >
            Ready to <Highlight class="text-primary" type="box"
              >Shield</Highlight
            > your network?
          </h2>
          <p class="text-muted-foreground text-lg leading-relaxed max-w-xl">
            Our experts are standing by to execute a deep-dive security audit of
            your infrastructure. Let's build something unhackable.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-8 pt-4">
          <div class="group">
            <p
              class="text-[10px] font-black uppercase tracking-[0.2em] text-primary mb-3"
            >
              Support Line
            </p>
            <p
              class="text-xl font-bold text-white group-hover:text-primary transition-colors cursor-pointer"
            >
              +1 (231) 550-1090
            </p>
          </div>
          <div class="group">
            <p
              class="text-[10px] font-black uppercase tracking-[0.2em] text-primary mb-3"
            >
              Email Shield
            </p>
            <p
              class="text-xl font-bold text-white group-hover:text-primary transition-colors cursor-pointer"
            >
              team@codeshieldai.com
            </p>
          </div>
        </div>

        <!-- Technical Map Card -->
        <div
          class="relative bg-[#0F0F11] border border-white/10 rounded-3xl overflow-hidden group h-64"
        >
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3022.4069438494266!2d-74.00203532397225!3d40.75307347138754!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c259b3e617679b%3A0x83e72e267005b779!2s450%20W%2033rd%20St%20%23801%2C%20New%20York%2C%20NY%2010001%2C%20USA!5e0!3m2!1sen!2slk!4v1771054429757!5m2!1sen!2slk"
            class="absolute inset-0 w-full h-full grayscale invert opacity-40 group-hover:opacity-60 transition-opacity duration-700"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"></iframe>
          <div
            class="absolute inset-0 bg-gradient-to-t from-[#0F0F11] via-transparent to-transparent pointer-events-none"
          >
          </div>
          <div class="absolute bottom-6 left-6 flex items-center gap-3">
            <div class="w-2 h-2 rounded-full bg-primary animate-pulse"></div>
            <span
              class="text-[10px] font-black uppercase tracking-widest text-white/80"
              >HQ: New York, NY 10001, USA</span
            >
          </div>
        </div>
      </div>

      <div class="relative w-full">
        <div
          id="contact-form-container"
          class="bg-[#0B0B0C] border border-white/5 rounded-3xl md:rounded-[2.5rem] p-5 sm:p-8 md:p-12 relative z-10 min-h-0 md:min-h-[600px] flex flex-col w-full"
        >
          <!-- Form State -->
          <div id="form-state" class="flex-1 flex flex-col h-full">
            <h3
              class="text-xl md:text-2xl font-bold text-white uppercase tracking-tight mb-8 flex items-center gap-2 md:gap-3"
            >
              <span class="w-5 md:w-8 h-px bg-primary shrink-0"></span>
              Send Message
            </h3>

            <form
              id="shield-contact-form"
              action="https://formspree.io/f/xpqjdvna"
              method="POST"
              class="space-y-6 flex-1 flex flex-col"
            >
              <div class="grid sm:grid-cols-2 gap-6">
                <div class="space-y-2">
                  <label
                    for="name"
                    class="text-[10px] font-black uppercase tracking-[0.2em] text-white/40"
                    >Full name</label
                  >
                  <input
                    id="name"
                    name="name"
                    type="text"
                    required
                    placeholder="Your Full Name"
                    class="w-full bg-white/5 border border-white/10 rounded-xl md:rounded-2xl px-5 md:px-6 py-3.5 md:py-4 text-white placeholder:text-white/20 focus:border-primary/50 focus:bg-white/[0.07] outline-none transition-all"
                  />
                </div>
                <div class="space-y-2">
                  <label
                    for="email"
                    class="text-[10px] font-black uppercase tracking-[0.2em] text-white/40"
                    >Email address</label
                  >
                  <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    placeholder="Your@gmail.com"
                    class="w-full bg-white/5 border border-white/10 rounded-xl md:rounded-2xl px-5 md:px-6 py-3.5 md:py-4 text-white placeholder:text-white/20 focus:border-primary/50 focus:bg-white/[0.07] outline-none transition-all"
                  />
                </div>
              </div>

              <div class="space-y-2">
                <label
                  for="company"
                  class="text-[10px] font-black uppercase tracking-[0.2em] text-white/40"
                  >Organization</label
                >
                <input
                  id="company"
                  name="company"
                  type="text"
                  required
                  placeholder="Company Name"
                  class="w-full bg-white/5 border border-white/10 rounded-xl md:rounded-2xl px-5 md:px-6 py-3.5 md:py-4 text-white placeholder:text-white/20 focus:border-primary/50 focus:bg-white/[0.07] outline-none transition-all"
                />
              </div>

              <div class="space-y-2 flex-1 flex flex-col">
                <label
                  for="message"
                  class="text-[10px] font-black uppercase tracking-[0.2em] text-white/40"
                  >Intelligence Packet</label
                >
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  required
                  placeholder="How can we assist your security posture?"
                  class="w-full flex-1 bg-white/5 border border-white/10 rounded-xl md:rounded-2xl px-5 md:px-6 py-3.5 md:py-4 text-white placeholder:text-white/20 focus:border-primary/50 focus:bg-white/[0.07] outline-none transition-all resize-none min-h-[120px]"
                ></textarea>
              </div>

              <div
                class="turnstile-wrapper w-full overflow-hidden flex justify-center sm:justify-start"
              >
                <div
                  class="cf-turnstile"
                  data-sitekey={turnstileSiteKey}
                  data-theme="dark"
                  data-size="flexible"
                  data-callback="onTurnstileSuccess"
                  data-expired-callback="onTurnstileExpired"
                  data-error-callback="onTurnstileError"
                >
                </div>
              </div>

              <button
                type="submit"
                id="submit-btn"
                disabled
                class="group w-full bg-primary py-5 rounded-full font-black uppercase tracking-[0.2em] text-white text-sm transition-transform active:scale-[0.98] mt-4 flex items-center justify-center gap-3 hover:bg-primary/90 opacity-50 cursor-not-allowed pointer-events-none"
              >
                <span id="btn-text">Deploy Message</span>
                <svg
                  id="btn-arrow"
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="group-hover:translate-x-1 transition-transform"
                  ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                  ></path></svg
                >
                <!-- Loading Spinner (hidden by default) -->
                <svg
                  id="btn-spinner"
                  class="hidden animate-spin"
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
                </svg>
              </button>
            </form>
          </div>

          <!-- Success State -->
          <div
            id="success-state"
            class="hidden flex-1 flex flex-col items-center justify-center text-center space-y-8 animate-in fade-in zoom-in duration-500"
          >
            <div class="relative">
              <div
                class="w-24 h-24 bg-primary/10 rounded-full flex items-center justify-center border border-primary/20"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="40"
                  height="40"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-primary"
                  ><polyline points="20 6 9 17 4 12"></polyline></svg
                >
              </div>
              <div
                class="absolute -inset-4 bg-primary/20 blur-2xl rounded-full -z-10 animate-pulse"
              >
              </div>
            </div>

            <div class="space-y-4">
              <h3
                class="text-3xl font-black text-white uppercase tracking-tight"
              >
                Mission Accomplished
              </h3>
              <p
                class="text-muted-foreground max-w-xs mx-auto text-sm leading-relaxed"
              >
                Your intelligence packet has been encrypted and deployed. Our
                team will contact you shortly.
              </p>
            </div>

            <button
              id="reset-form"
              class="px-8 py-3 rounded-full border border-white/10 text-[10px] font-black uppercase tracking-widest text-white/40 hover:text-white hover:border-white/20 transition-all"
            >
              Send Another Message
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Cloudflare Turnstile Script -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer
></script>

<script>
  function initContactForm() {
    const form = document.getElementById(
      "shield-contact-form",
    ) as HTMLFormElement;
    const formState = document.getElementById("form-state");
    const successState = document.getElementById("success-state");
    const resetBtn = document.getElementById("reset-form");

    if (!form || !formState || !successState || !resetBtn) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Get form data
      const formData = new FormData(form);

      // Get button elements
      const btn = document.getElementById(
        "submit-btn",
      ) as HTMLButtonElement | null;
      const btnText = document.getElementById("btn-text");
      const btnArrow = document.getElementById("btn-arrow");
      const btnSpinner = document.getElementById("btn-spinner");

      // Set loading state
      if (btn && btnText && btnArrow && btnSpinner) {
        btn.classList.add("opacity-75", "pointer-events-none");
        btnText.textContent = "Processing";
        btnArrow.classList.add("hidden");
        btnSpinner.classList.remove("hidden");
      }

      try {
        // Submit to Formspree using AJAX
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: {
            Accept: "application/json",
          },
        });

        if (response.ok) {
          // Show custom success message
          setTimeout(() => {
            formState.classList.add("hidden");
            successState.classList.remove("hidden");
            form.reset();

            // Reset button state
            if (btn && btnText && btnArrow && btnSpinner) {
              btn.classList.remove("opacity-75", "pointer-events-none");
              btnText.textContent = "Deploy Message";
              btnArrow.classList.remove("hidden");
              btnSpinner.classList.add("hidden");
            }
          }, 800);
        } else {
          // Handle error
          const data = await response.json();
          alert(
            data.errors?.map((e: any) => e.message).join(", ") ||
              "Oops! There was a problem submitting your form",
          );

          // Reset button state
          if (btn && btnText && btnArrow && btnSpinner) {
            btn.classList.remove("opacity-75", "pointer-events-none");
            btnText.textContent = "Deploy Message";
            btnArrow.classList.remove("hidden");
            btnSpinner.classList.add("hidden");
          }
        }
      } catch (error) {
        console.error("Form submission error:", error);
        alert(
          "Oops! There was a problem submitting your form. Please try again.",
        );

        // Reset button state
        if (btn && btnText && btnArrow && btnSpinner) {
          btn.classList.remove("opacity-75", "pointer-events-none");
          btnText.textContent = "Deploy Message";
          btnArrow.classList.remove("hidden");
          btnSpinner.classList.add("hidden");
        }
      }
    });

    resetBtn.addEventListener("click", () => {
      successState.classList.add("hidden");
      formState.classList.remove("hidden");

      // Reset button state
      const btn = document.getElementById("submit-btn") as HTMLButtonElement;
      if (btn) {
        btn.disabled = true;
        btn.classList.add(
          "opacity-50",
          "cursor-not-allowed",
          "pointer-events-none",
        );
      }

      // Reset Turnstile widget if available
      if (typeof turnstile !== "undefined") {
        turnstile.reset();
      }
    });
  }

  // Global Turnstile Callbacks
  (window as any).onTurnstileSuccess = function () {
    const btn = document.getElementById("submit-btn") as HTMLButtonElement;
    if (btn) {
      btn.disabled = false;
      btn.classList.remove(
        "opacity-50",
        "cursor-not-allowed",
        "pointer-events-none",
      );
    }
  };

  (window as any).onTurnstileExpired = (window as any).onTurnstileError =
    function () {
      const btn = document.getElementById("submit-btn") as HTMLButtonElement;
      if (btn) {
        btn.disabled = true;
        btn.classList.add(
          "opacity-50",
          "cursor-not-allowed",
          "pointer-events-none",
        );
      }
    };

  // Initialize
  initContactForm();
  document.addEventListener("astro:after-swap", initContactForm);
</script>

<style>
  #contact-form-container {
    transition: height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>
