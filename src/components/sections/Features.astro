---
import Highlight from "../Highlight.astro";
const features = [
  {
    title: "Vulnerability Analysis",
    desc: "Deep-probe AI analysis to identify code-level risks and security flaws instantly.",
    icon: "/Features icons.svg",
  },
  {
    title: "Security Monitoring",
    desc: "Real-time oversight for your cloud infrastructure and hybrid environments.",
    icon: "/Features icons (2).svg",
  },
  {
    title: "Risk Detection",
    desc: "Automated alerts and instant responses for detected threats across systems.",
    icon: "/Features icons (3).svg",
  },
  {
    title: "Intelligence Dashboards",
    desc: "Comprehensive visibility into risk metrics and security posture in one place.",
    icon: "/Features icons (4).svg",
  },
];
---

<section
  id="features"
  class="py-16 md:py-24 px-4 sm:px-6 md:px-12 bg-background relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Heading -->
    <div
      class="text-center mb-16 md:mb-24 space-y-4 flex flex-col items-center"
    >
      <span
        class="text-primary font-bold text-sm tracking-widest uppercase mb-2 md:mb-2 block text-center"
        >Features</span
      >
      <h2
        class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl font-black text-foreground tracking-tight leading-[1.1] max-w-4xl mx-auto"
      >
        What Makes Shield <Highlight class="text-primary" type="box"
          >Your Best</Highlight
        >
        <br class="hidden md:block" />
        Security Partner?
      </h2>
      <p
        class="text-muted-foreground text-sm md:text-base leading-relaxed font-medium max-w-2xl mx-auto"
      >
        Our advanced security ecosystem delivers end-to-end protection for
        modern codebases and cloud infrastructure, ensuring integrity,
        resilience, and performance at scale.
      </p>
    </div>

    <!-- The Hub Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center relative">
      <!-- Connecting Lines (Desktop Only) -->
      <svg
        class="hidden lg:block absolute inset-0 w-full h-full pointer-events-none z-0"
        viewBox="0 0 1200 800"
        fill="none"
        preserveAspectRatio="none"
      >
        <!-- Top Left Path -->
        <path
          d="M300 180 L350 180 L350 350 L450 350"
          stroke="currentColor"
          stroke-width="2"
          class="text-primary/50"
          fill="none"></path>
        <circle cx="450" cy="350" r="4" class="fill-secondary"></circle>
        <circle cx="300" cy="180" r="4" class="fill-primary"></circle>

        <!-- Bottom Left Path -->
        <path
          d="M300 620 L400 620 L400 450 L450 450"
          stroke="currentColor"
          stroke-width="2"
          class="text-primary/50"
          fill="none"></path>
        <circle cx="450" cy="450" r="4" class="fill-secondary"></circle>
        <circle cx="300" cy="620" r="4" class="fill-primary"></circle>

        <!-- Top Right Path -->
        <path
          d="M900 180 L850 180 L850 350 L750 350"
          stroke="currentColor"
          stroke-width="2"
          class="text-primary/50"
          fill="none"></path>
        <circle cx="750" cy="350" r="4" class="fill-secondary"></circle>
        <circle cx="900" cy="180" r="4" class="fill-primary"></circle>

        <!-- Bottom Right Path -->
        <path
          d="M900 620 L800 620 L800 450 L750 450"
          stroke="currentColor"
          stroke-width="2"
          class="text-primary/50"
          fill="none"></path>
        <circle cx="750" cy="450" r="4" class="fill-secondary"></circle>
        <circle cx="900" cy="620" r="4" class="fill-primary"></circle>
      </svg>

      <!-- Left Column -->
      <div
        class="flex flex-col gap-12 lg:gap-64 order-2 lg:order-1 relative z-10"
      >
        <!-- Feature 1 (Top Left) -->
        <div
          class="bg-card/80 backdrop-blur-md border border-border p-6 rounded-2xl shadow-xl hover:border-primary/50 transition-colors duration-300 lg:mr-12 lg:text-right flex flex-col lg:items-end group/f1"
        >
          <div class="flex items-center gap-4 mb-4 lg:flex-row-reverse">
            <div
              class="w-14 h-14 bg-primary/10 rounded-2xl flex items-center justify-center border border-primary/30 shadow-[0_0_20px_rgba(126,103,241,0.15)] group-hover/f1:scale-110 transition-transform duration-500 relative"
            >
              <div
                class="absolute inset-[2px] rounded-2xl border border-white/5 bg-gradient-to-br from-white/10 to-transparent"
              >
              </div>
              <img
                src={features[0].icon}
                alt={features[0].title}
                class="w-10 h-10 object-contain relative z-10"
              />
            </div>
            <h3 class="text-xl font-black text-foreground">
              {features[0].title}
            </h3>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed">
            {features[0].desc}
          </p>
        </div>

        <!-- Feature 2 (Bottom Left) -->
        <div
          class="bg-card/80 backdrop-blur-md border border-border p-6 rounded-2xl shadow-xl hover:border-primary/50 transition-colors duration-300 lg:mr-12 lg:text-right flex flex-col lg:items-end group/f2"
        >
          <div class="flex items-center gap-4 mb-4 lg:flex-row-reverse">
            <div
              class="w-14 h-14 bg-primary/10 rounded-2xl flex items-center justify-center border border-primary/30 shadow-[0_0_20px_rgba(126,103,241,0.15)] group-hover/f2:scale-110 transition-transform duration-500 relative"
            >
              <div
                class="absolute inset-[2px] rounded-2xl border border-white/5 bg-gradient-to-br from-white/10 to-transparent"
              >
              </div>
              <img
                src={features[1].icon}
                alt={features[1].title}
                class="w-10 h-10 object-contain relative z-10"
              />
            </div>
            <h3 class="text-xl font-black text-foreground">
              {features[1].title}
            </h3>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed">
            {features[1].desc}
          </p>
        </div>
      </div>

      <!-- Center Column (Image) -->
      <div
        class="order-1 lg:order-2 flex justify-center relative z-20 py-12 lg:py-0"
      >
        <div
          class="relative w-72 h-72 sm:w-80 sm:h-80 lg:w-[400px] lg:h-[400px]"
        >
          <!-- Glow Effect -->
          <div
            class="absolute inset-0 bg-primary/20 blur-[60px] rounded-full animate-pulse"
          >
          </div>

          <!-- The Main Object -->
          <div
            class="relative w-full h-full bg-gradient-to-br from-card to-background rounded-full border border-border/50 shadow-2xl overflow-hidden flex items-center justify-center group/core"
          >
            <!-- Inner Animated Core -->
            <div
              class="absolute inset-4 rounded-full border border-primary/20 border-dashed animate-[spin_10s_linear_infinite]"
            >
            </div>
            <div
              class="absolute inset-12 rounded-full border border-secondary/20 border-dotted animate-[spin_15s_linear_infinite_reverse]"
            >
            </div>

            <!-- Central Visual -->
            <div
              class="relative z-10 w-2/3 h-2/3 bg-black rounded-full shadow-[inset_0_0_40px_rgba(126,103,241,0.5)] flex items-center justify-center overflow-hidden"
            >
              <img
                src="/features image.png"
                class="w-full h-full object-cover opacity-80 mix-blend-screen hover:scale-110 transition-transform duration-700"
                alt="Security Core"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column -->
      <div class="flex flex-col gap-12 lg:gap-64 order-3 relative z-10">
        <!-- Feature 3 (Top Right) -->
        <div
          class="bg-card/80 backdrop-blur-md border border-border p-6 rounded-2xl shadow-xl hover:border-primary/50 transition-colors duration-300 lg:ml-12 flex flex-col group/f3"
        >
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-14 h-14 bg-primary/10 rounded-2xl flex items-center justify-center border border-primary/30 shadow-[0_0_20px_rgba(126,103,241,0.15)] group-hover/f3:scale-110 transition-transform duration-500 relative"
            >
              <div
                class="absolute inset-[2px] rounded-2xl border border-white/5 bg-gradient-to-br from-white/10 to-transparent"
              >
              </div>
              <img
                src={features[2].icon}
                alt={features[2].title}
                class="w-10 h-10 object-contain relative z-10"
              />
            </div>
            <h3 class="text-xl font-black text-foreground">
              {features[2].title}
            </h3>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed">
            {features[2].desc}
          </p>
        </div>

        <!-- Feature 4 (Bottom Right) -->
        <div
          class="bg-card/80 backdrop-blur-md border border-border p-6 rounded-2xl shadow-xl hover:border-primary/50 transition-colors duration-300 lg:ml-12 flex flex-col group/f4"
        >
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-14 h-14 bg-primary/10 rounded-2xl flex items-center justify-center border border-primary/30 shadow-[0_0_20px_rgba(126,103,241,0.15)] group-hover/f4:scale-110 transition-transform duration-500 relative"
            >
              <div
                class="absolute inset-[2px] rounded-2xl border border-white/5 bg-gradient-to-br from-white/10 to-transparent"
              >
              </div>
              <img
                src={features[3].icon}
                alt={features[3].title}
                class="w-10 h-10 object-contain relative z-10"
              />
            </div>
            <h3 class="text-xl font-black text-foreground">
              {features[3].title}
            </h3>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed">
            {features[3].desc}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* SVG Path responsiveness tweak - simplified assumption for demo */
  /* In a real prod environment, individual SVGs per quadrant might be more robust */
</style>
