---
import Highlight from "../Highlight.astro";

const steps = [
  {
    num: "01",
    title: "Integrate Assets",
    desc: "Connect your repositories and cloud infrastructure for a deep-probe security sweep.",
    icon: `<path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/>`,
    img: "/Process images.png"
  },
  {
    num: "02",
    title: "AI Analysis",
    desc: "Our neural engine scans millions of logic branches to expose hidden risks and vulnerabilities.",
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/>`,
    img: "/Process images (2).png"
  },
  {
    num: "03",
    title: "Shield & Monitor",
    desc: "Apply automated security patches and maintain constant 24/7 vigil over your live environment.",
    icon: `<path d="M12 2v20"/><path d="m5 15 7-7 7 7"/>`,
    img: "/Process images (3).png"
  }
];
---

<section id="howitworks" class="py-16 md:py-24 px-4 sm:px-6 md:px-12 bg-background overflow-hidden relative">
  <div class="max-w-7xl mx-auto">
    
    <!-- Split Heading Area -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 md:mb-20 items-center">
      <div class="lg:col-span-6 space-y-4">
        <span class="text-primary font-bold text-sm tracking-widest uppercase mb-2 block">Process</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl font-black text-foreground uppercase tracking-tight leading-[1.1]">
          Simple Steps to <Highlight class="text-primary" type="box">Secure</Highlight> Your Infrastructure
        </h2>
      </div>
      <div class="lg:col-span-6">
        <p class="text-muted-foreground text-sm md:text-base lg:text-sm leading-relaxed font-medium lg:border-l lg:border-border/50 lg:pl-10">
          Our streamlined workflow ensures your code and cloud assets are protected with minimal friction and maximum intelligence. We combine deep-probe scanning with automated patching for a seamless security experience and continuous protection and compliance. 
        </p>
      </div>
    </div>

    <!-- Unique Horizontal Panoramic Steps -->
    <div class="relative">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 relative z-10">
        {steps.map((s, i) => (
          <div class="relative h-full group/card md:last:col-span-2 lg:last:col-span-1">
            <!-- Step Card -->
            <div class="bg-[#0a0a0b] border border-white/5 rounded-[2rem] overflow-hidden flex flex-col h-full shadow-[0_15px_40px_rgba(0,0,0,0.25)] relative hover:border-primary/50 transition-colors duration-500 transform-gpu">
              
              <!-- Floating Image Section -->
              <div class="px-4 pt-4 relative">
                 <div class="relative h-44 lg:h-48 overflow-hidden rounded-[1.4rem] shadow-inner group/lens transform-gpu">
                    <img 
                      src={s.img} 
                      alt={s.title}
                      loading="lazy"
                      decoding="async"
                      width="600"
                      height="400"
                      class="w-full h-full object-cover opacity-80 group-hover/card:scale-110 transition-transform duration-700 will-change-transform"
                    />
                    
                    <!-- Tactical Overlays -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent pointer-events-none"></div>
                    <div class="absolute inset-0 bg-[linear-gradient(rgba(126,103,241,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(126,103,241,0.05)_1px,transparent_1px)] bg-[size:15px_15px] opacity-15 pointer-events-none"></div>
                    
                    <!-- Floating Security Tag (Step Number) -->
                    <div class="absolute bottom-4 left-4 right-4 flex justify-between items-end z-20">
                      <div class="bg-primary px-2.5 py-1 rounded text-[9px] font-black uppercase tracking-[0.15em] text-white shadow-lg">
                        Step {s.num}
                      </div>
                      <div class="w-10 h-10 bg-white/20 rounded-full border border-white/20 flex items-center justify-center text-white font-medium text-lg transition-transform duration-500 group-hover/card:scale-110 group-hover/card:-rotate-12 transform-gpu">
                        {s.num}
                      </div>
                    </div>
                 </div>
              </div>

              <!-- Content Layer -->
              <div class="p-8 flex flex-col flex-grow relative z-10">
                <div class="mb-5">
                  <h3 class="text-xl lg:text-2xl font-medium text-foreground uppercase tracking-tight leading-tight">
                    {s.title}
                  </h3>
                </div>

                <p class="text-sm lg:text-base text-muted-foreground leading-relaxed font-medium mb-6">
                  {s.desc}
                </p>

                <!-- Bottom Footer Info -->
                <div class="mt-auto pt-5 border-t border-white/5 flex items-center justify-between">
                  <span class="text-[9px] font-bold text-primary/40 uppercase tracking-[0.2em]">Deployment Stream</span>
                  <div class="flex gap-1 items-center">
                    <div class="w-1 h-1 rounded-full bg-primary/20"></div>
                    <div class="w-1 h-1 rounded-full bg-primary/50"></div>
                    <div class="w-3 h-0.5 rounded-full bg-primary animate-pulse"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
