---
import "@/styles/starwind.css";
import DockNavbar from "@/components/DockNavbar.astro";
import Footer from "@/components/sections/Footer.astro";
import Highlight from "@/components/Highlight.astro";
import Marquee from "@/components/sections/Marquee.astro";
import CookieBanner from "@/components/CookieBanner.astro";
---

<html lang="en" class="dark">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <title>CodeForge | Autonomous Security & Code Analysis</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Exo:ital,wght@0,100..900;1,100..900&display=swap"
            rel="stylesheet"
        />
        <link rel="canonical" href="https://codeshieldai.com/shield-ai" />
        <!--Start of Tawk.to Script-->
        <script type="text/javascript">
            var Tawk_API = Tawk_API || {},
                Tawk_LoadStart = new Date();
            (function () {
                var s1 = document.createElement("script"),
                    s0 = document.getElementsByTagName("script")[0];
                s1.async = true;
                s1.src =
                    "https://embed.tawk.to/6992b7b573d8cb1c357e2899/1jhihr869";
                s1.charset = "UTF-8";
                s1.setAttribute("crossorigin", "*");
                s0.parentNode.insertBefore(s1, s0);
            })();
        </script>
        <!--End of Tawk.to Script-->
    </head>
    <body
        class="bg-[#0F0F11] text-foreground font-['Exo',sans-serif] selection:bg-secondary selection:text-foreground overflow-x-hidden"
    >
        <DockNavbar />

        <!-- SECTION 1: HERO -->
        <section
            class="relative min-h-[40vh] flex items-center justify-center overflow-hidden pt-20 pb-4"
        >
            <!-- High-Tech Background -->
            <div class="absolute inset-0 z-0">
                <div
                    class="absolute inset-0 bg-gradient-to-b from-primary/10 via-transparent to-transparent opacity-30"
                >
                </div>
                <div
                    class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full bg-[radial-gradient(circle_at_50%_-20%,rgba(126,103,241,0.15),transparent_70%)]"
                >
                </div>

                <!-- Animated Grid -->
                <div
                    class="absolute inset-0 opacity-[0.05]"
                    style="background-image: radial-gradient(circle, #7E67F1 1px, transparent 1px); background-size: 40px 40px;"
                >
                </div>
            </div>

            <div class="container mx-auto px-6 relative z-10 text-center">
                <h1
                    class="text-5xl sm:text-6xl md:text-7xl font-black uppercase tracking-tighter leading-[1.2] text-white mb-8"
                >
                    The Future of <br />
                    <Highlight class="text-primary" type="box"
                        >Autonomous</Highlight
                    > Defense
                </h1>

                <p
                    class="text-muted-foreground text-md md:text-md max-w-2xl mx-auto mb-12 leading-relaxed"
                >
                    CodeShield AI pioneers zero-human intervention security,
                    merging deep-learning vulnerability detection with
                    autonomous infrastructure hardening.
                </p>
            </div>
        </section>

        <!-- MARQUEE DIVIDER -->
        <Marquee
            text1="AUTONOMOUS DEFENSE • AI DRIVEN SECURITY • ZERO TRUST ARCHITECTURE •"
            text2="ENTERPRISE READY • INFRASTRUCTURE HARDENING • CONTINUOUS MONITORING •"
        />

        <!-- SECTION 2: CORE CAPABILITIES -->
        <section class="py-24 px-6 relative bg-[#0F0F11]">
            <div class="max-w-7xl mx-auto">
                <div
                    class="grid lg:grid-cols-2 gap-12 mb-16 md:mb-20 items-end"
                >
                    <div class="space-y-4">
                        <span
                            class="text-primary font-bold text-sm tracking-widest uppercase block mb-1"
                            >Core Systems</span
                        >
                        <h2
                            class="text-3xl md:text-4xl lg:text-5xl font-black text-white uppercase tracking-tight leading-[1.05]"
                        >
                            Engineering <br />
                            <Highlight class="text-primary" type="box"
                                >Unbreakable</Highlight
                            >
                        </h2>
                    </div>
                    <p
                        class="text-muted-foreground text-sm lg:text-base leading-relaxed font-medium max-w-lg lg:text-right ml-auto"
                    >
                        Our platform integrates into every layer of your stack,
                        from the first line of code to the final edge
                        deployment, ensuring a seamless security posture.
                    </p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <!-- Card 1 -->
                    <div
                        class="group p-8 rounded-[2rem] bg-[#0B0B0C] border border-white/5 hover:border-primary/30 transition-all duration-500 shadow-2xl relative overflow-hidden"
                    >
                        <div
                            class="absolute -top-12 -right-12 w-24 h-24 bg-primary/10 blur-3xl rounded-full group-hover:bg-primary/20 transition-all"
                        >
                        </div>
                        <div
                            class="mb-6 w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path d="m18 16 4-4-4-4"></path><path
                                    d="m6 8-4 4 4 4"></path><path
                                    d="m14.5 4-5 16"></path></svg
                            >
                        </div>
                        <h3
                            class="text-xl font-bold text-white mb-4 uppercase tracking-tight"
                        >
                            AI Vulnerability Detection
                        </h3>
                        <p
                            class="text-sm text-muted-foreground leading-relaxed"
                        >
                            Deep-probe neural analysis of your codebase to
                            identify zero-day exploits before they commit.
                        </p>
                    </div>

                    <!-- Card 2 -->
                    <div
                        class="group p-8 rounded-[2rem] bg-[#0B0B0C] border border-white/5 hover:border-secondary/30 transition-all duration-500 shadow-2xl relative overflow-hidden"
                    >
                        <div
                            class="absolute -top-12 -right-12 w-24 h-24 bg-secondary/10 blur-3xl rounded-full group-hover:bg-secondary/20 transition-all"
                        >
                        </div>
                        <div
                            class="mb-6 w-12 h-12 rounded-xl bg-secondary/10 border border-secondary/20 flex items-center justify-center text-secondary"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path
                                    d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"
                                ></path></svg
                            >
                        </div>
                        <h3
                            class="text-xl font-bold text-white mb-4 uppercase tracking-tight"
                        >
                            Infra Risk Analysis
                        </h3>
                        <p
                            class="text-sm text-muted-foreground leading-relaxed"
                        >
                            Autonomous mapping of cloud misconfigurations and
                            network vulnerabilities across AWS, GCP, and Azure.
                        </p>
                    </div>

                    <!-- Card 3 -->
                    <div
                        class="group p-8 rounded-[2rem] bg-[#0B0B0C] border border-white/5 hover:border-primary/30 transition-all duration-500 shadow-2xl relative overflow-hidden"
                    >
                        <div
                            class="absolute -top-12 -right-12 w-24 h-24 bg-primary/10 blur-3xl rounded-full group-hover:bg-primary/20 transition-all"
                        >
                        </div>
                        <div
                            class="mb-6 w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path
                                    d="M11 2a2 2 0 0 0-2 2v5H4a2 2 0 0 0-2 2v2c0 1.1.9 2 2 2h5v5c0 1.1.9 2 2 2h2a2 2 0 0 0 2-2v-5h5a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2h-5V4a2 2 0 0 0-2-2h-2z"
                                ></path></svg
                            >
                        </div>
                        <h3
                            class="text-xl font-bold text-white mb-4 uppercase tracking-tight"
                        >
                            Risk Scoring Engine
                        </h3>
                        <p
                            class="text-sm text-muted-foreground leading-relaxed"
                        >
                            Quantifiable security metrics processed through our
                            proprietary AI-Risk model for actionable
                            prioritization.
                        </p>
                    </div>

                    <!-- Card 4 -->
                    <div
                        class="group p-8 rounded-[2rem] bg-[#0B0B0C] border border-white/5 hover:border-secondary/30 transition-all duration-500 shadow-2xl relative overflow-hidden"
                    >
                        <div
                            class="absolute -top-12 -right-12 w-24 h-24 bg-secondary/10 blur-3xl rounded-full group-hover:bg-secondary/20 transition-all"
                        >
                        </div>
                        <div
                            class="mb-6 w-12 h-12 rounded-xl bg-secondary/10 border border-secondary/20 flex items-center justify-center text-secondary"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><rect width="7" height="9" x="3" y="3" rx="1"
                                ></rect><rect
                                    width="7"
                                    height="5"
                                    x="14"
                                    y="3"
                                    rx="1"></rect><rect
                                    width="7"
                                    height="9"
                                    x="14"
                                    y="12"
                                    rx="1"></rect><rect
                                    width="7"
                                    height="5"
                                    x="3"
                                    y="16"
                                    rx="1"></rect></svg
                            >
                        </div>
                        <h3
                            class="text-xl font-bold text-white mb-4 uppercase tracking-tight"
                        >
                            Unified Dashboard
                        </h3>
                        <p
                            class="text-sm text-muted-foreground leading-relaxed"
                        >
                            A tactical mission control centers for CISOs,
                            offering global visibility into threat landscapes
                            and status.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 3: INTERACTIVE LIVE DEMO -->
        <section class="py-24 px-6 bg-[#0F0F11] relative overflow-hidden">
            <!-- Background Glow -->
            <div
                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-primary/5 blur-[120px] rounded-full pointer-events-none"
            >
            </div>

            <div class="max-w-5xl mx-auto relative z-10">
                <div
                    class="mb-16 md:mb-20 flex flex-col items-center justify-center text-center space-y-4 max-w-3xl mx-auto"
                >
                    <span
                        class="text-primary font-bold text-sm tracking-widest uppercase block mb-1"
                        >Live Intelligence</span
                    >
                    <h2
                        class="text-3xl md:text-4xl lg:text-5xl font-black text-white uppercase tracking-tight leading-[1.05]"
                    >
                        Experience the <Highlight
                            class="text-primary"
                            type="box">Vigilance</Highlight
                        >
                    </h2>
                    <p
                        class="text-muted-foreground text-sm lg:text-base leading-relaxed font-medium max-w-lg mx-auto pt-2"
                    >
                        Paste your sensitive code below to witness AI-driven
                        security analysis in real-time.
                    </p>
                </div>

                <!-- Terminal / IDE Interface -->
                <div
                    class="bg-[#0B0B0C] border border-white/10 rounded-[2.5rem] overflow-hidden shadow-[0_30px_100px_rgba(0,0,0,0.5)]"
                >
                    <!-- Terminal Header -->
                    <div
                        class="bg-white/5 px-8 py-4 border-b border-white/10 flex items-center justify-between"
                    >
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 rounded-full bg-[#FF5F56]">
                            </div>
                            <div class="w-3 h-3 rounded-full bg-[#FFBD2E]">
                            </div>
                            <div class="w-3 h-3 rounded-full bg-[#27C93F]">
                            </div>
                            <span
                                class="ml-4 text-[10px] font-black uppercase tracking-widest text-white/40 italic"
                                >Deep_Probe_Scanner_v4.2</span
                            >
                        </div>
                        <div
                            class="text-[10px] font-black text-primary uppercase tracking-widest flex items-center gap-2"
                        >
                            <div
                                class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"
                            >
                            </div>
                            Live Server
                        </div>
                    </div>

                    <div class="p-8 md:p-12">
                        <div class="grid lg:grid-cols-2 gap-12">
                            <!-- IDE Input -->
                            <div class="space-y-6">
                                <div class="space-y-2">
                                    <label
                                        class="text-[10px] font-black uppercase tracking-widest text-white/40 ml-2"
                                        >Input Logic Bundle</label
                                    >
                                    <textarea
                                        id="demo-textarea"
                                        rows="10"
                                        placeholder="// Paste your code here...
export const handleLogin = async (data) => {
  const user = await db.find({ id: data.id });
  return user;
}"
                                        class="w-full bg-black/40 border border-white/10 rounded-2xl p-6 text-sm font-mono text-white placeholder:text-white/10 focus:border-primary/50 focus:ring-1 focus:ring-primary/20 outline-none transition-all resize-none shadow-inner"
                                        required></textarea>
                                </div>

                                <!-- Styled Analyze Button -->
                                <button
                                    id="analyze-btn"
                                    class="w-full bg-primary py-4 rounded-full font-black uppercase tracking-[0.2em] text-white text-sm transition-transform active:scale-[0.98] flex items-center justify-center gap-3 hover:bg-primary/90 shadow-[0_10px_40px_rgba(126,103,241,0.2)]"
                                >
                                    Initiate deep scan
                                </button>
                            </div>

                            <!-- Result Terminal -->
                            <div
                                id="result-pane"
                                class="bg-black/60 border border-white/5 rounded-3xl p-8 font-mono text-sm relative overflow-hidden flex flex-col justify-center items-center opacity-40 transition-all duration-500"
                            >
                                <div
                                    id="placeholder-text"
                                    class="text-white/20 text-center space-y-4"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="48"
                                        height="48"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="mx-auto opacity-20"
                                        ><path d="M12 2v20M2 12h20"></path></svg
                                    >
                                    <p
                                        class="uppercase tracking-[0.2em] font-black text-xs"
                                    >
                                        Waiting for payload...
                                    </p>
                                </div>

                                <!-- Analysis Display (Hidden initially) -->
                                <div
                                    id="analysis-results"
                                    class="hidden w-full space-y-6"
                                >
                                    <div
                                        class="flex items-center justify-between border-b border-white/10 pb-4"
                                    >
                                        <span
                                            class="text-[10px] font-black uppercase tracking-widest text-white/40"
                                            >Risk Intelligence Report</span
                                        >
                                        <span
                                            id="risk-score"
                                            class="text-2xl font-black text-secondary"
                                            >?</span
                                        >
                                    </div>

                                    <div class="space-y-4">
                                        <div class="flex items-center gap-4">
                                            <div
                                                class="w-1.5 h-10 rounded-full bg-secondary"
                                                id="severity-indicator"
                                            >
                                            </div>
                                            <div>
                                                <p
                                                    class="text-[9px] font-black uppercase tracking-widest text-secondary"
                                                    id="severity-label"
                                                >
                                                    Status Check
                                                </p>
                                                <p
                                                    class="text-white font-bold"
                                                    id="vulnerability-name"
                                                >
                                                    Scan in Progress...
                                                </p>
                                            </div>
                                        </div>

                                        <div
                                            class="bg-white/5 rounded-xl p-4 space-y-2"
                                        >
                                            <p
                                                class="text-[9px] font-black uppercase tracking-widest text-white/40"
                                            >
                                                Remediation Guidance
                                            </p>
                                            <p
                                                class="text-xs text-white/80 leading-relaxed"
                                                id="remediation-text"
                                            >
                                                Analyzing architectural patterns
                                                and data flow for potential
                                                vulnerabilities.
                                            </p>
                                        </div>
                                    </div>

                                    <div class="pt-4 flex items-center gap-3">
                                        <div
                                            class="w-2 h-2 rounded-full bg-secondary animate-pulse"
                                        >
                                        </div>
                                        <span
                                            class="text-[9px] font-black uppercase tracking-widest text-white/60"
                                            >AI Decision Verified</span
                                        >
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <Footer />

        <style>
            .mask-image-gradient {
                mask-image: linear-gradient(
                    to bottom,
                    black 50%,
                    transparent 100%
                );
            }

            #demo-textarea::placeholder {
                white-space: pre-wrap;
            }

            @keyframes fade-in-up {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
        </style>

        <script>
            const samples = [
                {
                    name: "SQL Injection Risk",
                    severity: "CRITICAL",
                    score: "9.8",
                    color: "#FF5F56",
                    remediation:
                        "Detected raw query string interpolation. Use parameterized queries or an ORM to prevent malicious intent injection into the database layer.",
                },
                {
                    name: "JWT Poisoning",
                    severity: "HIGH",
                    score: "8.4",
                    color: "#FFBD2E",
                    remediation:
                        "Weak signature verification detected. Ensure 'HS256' or 'RS256' algorithms are strictly enforced and secret rotation is active.",
                },
                {
                    name: "Logic Vulnerability",
                    severity: "MEDIUM",
                    score: "5.2",
                    color: "#7E67F1",
                    remediation:
                        "Insufficient authorization check on sensitive resource. Verify user ownership of the business object before allowing mutation.",
                },
            ];

            function initDemo() {
                const btn = document.getElementById("analyze-btn");
                const textarea = document.getElementById(
                    "demo-textarea",
                ) as HTMLTextAreaElement;
                const resultPane = document.getElementById("result-pane");
                const placeholder = document.getElementById("placeholder-text");
                const results = document.getElementById("analysis-results");

                const riskScore = document.getElementById("risk-score");
                const severityIndicator =
                    document.getElementById("severity-indicator");
                const severityLabel = document.getElementById("severity-label");
                const vulnName = document.getElementById("vulnerability-name");
                const remText = document.getElementById("remediation-text");

                btn?.addEventListener("click", () => {
                    if (!textarea.value.trim()) {
                        textarea.reportValidity();
                        return;
                    }

                    // Loading State
                    placeholder?.classList.add("hidden");
                    results?.classList.add("hidden");
                    resultPane?.classList.remove("opacity-40");
                    resultPane?.classList.add("bg-black/80");

                    btn.innerHTML = `Scanning Intelligence... <div class="w-4 h-4 border-2 border-white/20 border-t-white rounded-full animate-spin"></div>`;
                    btn.parentElement?.classList.add(
                        "opacity-50",
                        "pointer-events-none",
                    );

                    setTimeout(() => {
                        // Simulated Result
                        const randomSample =
                            samples[Math.floor(Math.random() * samples.length)];

                        results?.classList.remove("hidden");
                        if (riskScore)
                            riskScore.textContent = randomSample.score;
                        if (severityIndicator)
                            severityIndicator.style.backgroundColor =
                                randomSample.color;
                        if (severityLabel) {
                            severityLabel.textContent = randomSample.severity;
                            severityLabel.style.color = randomSample.color;
                        }
                        if (vulnName) vulnName.textContent = randomSample.name;
                        if (remText)
                            remText.textContent = randomSample.remediation;

                        btn.innerHTML = `Initiate deep scan <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:rotate-12"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>`;
                        btn.parentElement?.classList.remove(
                            "opacity-50",
                            "pointer-events-none",
                        );
                    }, 1500);
                });
            }

            initDemo();
            document.addEventListener("astro:after-swap", initDemo);
        </script>
        <CookieBanner />
    </body>
</html>
